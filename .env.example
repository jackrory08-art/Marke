# Copy to .env (never commit it). Loaded by run_with_dashboard.py.

# --- AI verifier / analyst (Google AI Studio key; free tier is enough) ---
GEMINI_API_KEY=
# Reserved for a future Anthropic provider (currently unused)
ANTHROPIC_API_KEY=

# --- Dashboard ---
# Optional: if set, session tokens are stored as HMAC-SHA256(secret, token).
# Changing it logs everyone out. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
MARKE_SESSION_SECRET=
# Overrides database.url in config.yaml (Postgres: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///data/marke.db

# --- Polymarket credentials (not needed for read-only dry-run use) ---
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=

# --- Hosting platforms (Railway, Render, Fly). See docs/railway.md ---
# Extra hostnames allowed in the Host header (comma-separated; loopback stays allowed).
MARKE_ALLOWED_HOSTS=
# For hosts with no shell: creates the owner on first start if no user exists.
# Remove MARKE_BOOTSTRAP_PASSWORD after you have signed in.
MARKE_BOOTSTRAP_USER=
MARKE_BOOTSTRAP_PASSWORD=
